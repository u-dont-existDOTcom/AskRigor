        "state.yes_once",
        "confirmation.consequential"
      ]
    },
    {
      "id": "yes_always_first_and_later",
      "scenario": "The user replies exactly Yes always in this chat, then AskRigor independently validates another lesson later in the same chat; Action results are not part of this authorization case.",
      "expected": {
        "lesson_proposed": true,
        "generalized_candidates_displayed": 2,
        "askrigor_consent_questions": 1,
        "action_calls": [
          {
            "operation": "submit_lesson_candidate",
