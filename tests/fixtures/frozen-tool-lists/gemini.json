            "required": [
              "url",
              "text",
              "retrieved_via"
            ]
          },
          "description": "Accepts up to two AI-supplied public-page. Items: 1–2."
        },
        "public_copy_search": {
          "type": "object",
          "properties": {
            "queries": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Length: 3–400."
              },
              "description": "Items: 2–12."
            }
          },
          "required": [
            "queries"
          ]
