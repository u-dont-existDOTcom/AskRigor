              "url"
            ]
          },
          "description": "Items: 1–5."
        },
        "candidate_texts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Records the public HTTPS page represented by the. Length: ≤4000."
              },
              "text": {
                "type": "string",
                "description": "Accepts the page text returned by the client's. Length: 2000–400000."
              },
              "retrieved_via": {
                "type": "string",
