          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Length: ≤4000."
              },
              "declared_class": {
                "type": "string",
                "enum": [
                  "publisher",
                  "repository",
                  "author_copy",
                  "researcher_upload",
                  "other"
                ]
