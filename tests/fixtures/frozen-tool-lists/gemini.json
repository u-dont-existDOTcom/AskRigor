  {
    "name": "submit_lesson_candidate",
    "description": "Report an AskRigor bug, preference, or feature request. Show the de-identified report first and submit only after the user agrees. Send one report per incident.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "description": "Lesson category: missing_sources, conflicting_claims, incomplete_research, evidence_weighting, community_corpus, tool_semantics, protocol_execution, privacy_or_safety, usability, other, or another value an AskRigor result names."
        },
        "general_lesson": {
          "type": "string",
          "description": "When [situation], AskRigor should [behavior] because [reason]."
        },
        "expected_behavior": {
          "type": "string",
          "description": "Expected result at the first failing step."
        },
        "failure_reason": {
          "type": "string"
        },
        "synthetic_regression_example": {
          "type": "string",
          "description": "Invent a reproduction and its expected result."
        },
        "evidence_basis": {
          "type": "string",
          "enum": [
            "assistant_self_check",
            "tool_receipt_conflict",
            "source_recheck",
            "instruction_mismatch"
          ]
        },
        "askrigor_version": {
          "type": "string"
        },
        "protocol_identities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ]
          }
        },
        "consent_scope": {
          "type": "string",
          "enum": [
            "once",
            "conversation"
          ],
          "description": "Use \"conversation\" only with consent for the whole chat."
        },
        "existing_rules": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "not_loaded",
                          "loaded_not_applied",
                          "applied_but_insufficient",
                          "not_triggered",
                          "unknown"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "status",
                      "reason"
                    ]
                  }
                }
              },
              "required": [
                "rules"
              ]
            },
            {
              "type": "object",
              "properties": {
                "none": {
                  "type": "string"
                }
              },
              "required": [
                "none"
              ]
            }
          ],
          "description": "Name exact current HRP or Universal rules and their status, or explain the missing rule in none."
        },
        "observed_behavior": {
          "type": "string",
          "description": "First observed failing step, without personal details."
        },
        "part_to_change": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tool",
                "protocol_rule",
                "final_check"
              ]
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "description": "Name the specific tool, protocol rule, or check."
        },
        "related_issue": {
          "description": "Public AskRigor issue number, if the user filed one. Range: 1–1000000.",
          "type": "integer"
        },
        "detailed_report": {
          "description": "Only if enabled in the account's AskRigor settings. Show it before asking for consent.",
          "type": "object",
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "observed": {
              "type": "string"
            },
            "expected": {
              "type": "string"
            },
            "causes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cause": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                },
                "required": [
                  "cause",
                  "confidence"
                ]
              }
            },
            "parts_to_change": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "proposed_change": {
              "type": "string"
            },
            "test_cases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "case": {
                    "type": "string"
                  },
                  "negative_control": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "case",
                  "negative_control"
                ]
              }
            },
            "uncertain": {
              "type": "string"
            }
          },
          "required": [
            "steps",
            "observed",
            "expected",
            "causes",
            "parts_to_change",
            "proposed_change",
            "test_cases",
            "uncertain"
          ]
        },
        "check_report_token": {
          "description": "Exact token from a stopped final check, after consent.",
          "type": "string"
        },
        "preventing_rule": {
          "description": "For a correction, the exact HRP or Universal rule shown to the user, or no_rule with missing_rule.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ]
        },
        "missing_rule": {
          "description": "With no_rule, give the one-line missing rule shown to the user.",
          "type": "string"
        }
      },
      "required": [
        "category",
        "general_lesson",
        "expected_behavior",
        "failure_reason",
        "synthetic_regression_example",
        "evidence_basis",
        "consent_scope",
        "existing_rules",
        "observed_behavior",
        "part_to_change"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
