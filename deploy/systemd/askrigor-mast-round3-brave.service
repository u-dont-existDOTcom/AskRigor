[Unit]
Description=AskRigor MAST Round 3 dedicated durable Brave
Requires=askrigor-mast-round3-xvfb.service
After=askrigor-mast-round3-xvfb.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudbrowser
Group=cloudbrowser
Environment=DISPLAY=:97
Environment=HOME=/home/cloudbrowser
ExecStart=/usr/local/lib/askrigor-mast-round3/brave-mast-round3.sh
Restart=always
RestartSec=3s
TimeoutStopSec=20s
KillMode=control-group
# Brave's installed setuid sandbox must be allowed to gain its narrowly scoped
# sandboxing privilege; blocking privilege gain prevents Brave from starting.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/cloudbrowser/.config/brave-mast-round3 /home/cloudbrowser/.cache /home/cloudbrowser/.local/share/askrigor-mast-round3

[Install]
WantedBy=multi-user.target
