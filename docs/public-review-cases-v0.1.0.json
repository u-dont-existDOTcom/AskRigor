      "expected_result_shape": {
        "required_fields": ["verified: true", "manifest.version: 20.5.16", "manifest.sha256: d41e37b13357542c8439ca5199d50eef9eec8aa6ec4beeafbfbbe44213362597", "complete canonical text"]
      },
      "no_state_change": true
    },
