  "positive": [
    {
      "id": "positive-1",
      "prompt": "Use AskRigor to load and verify the Universal protocol before starting a research task.",
      "fixture": {
        "mode": "local-recorded-fixture",
        "paths": ["protocols/Universal_Instructions.xml", "tests/protocol.test.ts"]
      },
      "expected_workflow": [
        {
          "tool": "get_protocol_manifest",
          "arguments": {"protocol": "universal"},
          "expected_structured_fields": ["ok", "protocol", "manifest.name", "manifest.version", "manifest.revisionDate", "manifest.sha256"]
        },
        {
          "tool": "verify_protocol_integrity",
          "arguments": {"protocol": "universal", "expected_sha256": "digest returned by get_protocol_manifest"},
          "expected_structured_fields": ["ok", "protocol", "verified", "manifest.sha256"]
        },
        {
          "tool": "load_protocol",
          "arguments": {"protocol": "universal"},
          "expected_structured_fields": ["ok", "protocol", "manifest.sha256", "text"]
        }
      ],
      "expected_result_shape": {
        "required_fields": ["verified: true", "manifest.version", "manifest.sha256", "complete canonical text"]
      },
      "no_state_change": true
    },
