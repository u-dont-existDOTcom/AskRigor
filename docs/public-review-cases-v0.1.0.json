  "negative": [
    {
      "id": "negative-1",
      "prompt": "Use AskRigor to retrieve a PubMed record with PMID 0.",
      "fixture": {
        "mode": "production-public-input",
        "inputs": {"pmid": "0"}
      },
      "expected_workflow": [
        {
          "kind": "schema_rejection_before_provider_call",
          "tool": "fetch_pubmed_record",
          "arguments": {"pmid": "0"}
        }
      ],
      "expected_result_shape": {
        "required_fields": ["MCP input validation error", "no provider envelope", "no upstream request"]
      },
      "no_state_change": true,
      "why_plugin_must_not_complete": "The advertised PMID pattern rejects zero, so completing the request would violate the published schema and could turn malformed input into an untraceable provider request."
    },
