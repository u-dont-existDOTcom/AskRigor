{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://askrigor.com/schemas/community-health-forum-and-public-lead-contract-v0.1.0.json",
  "title": "AskRigor Community Health Forum and Public Lead Frontier contract bundle",
  "description": "Machine-readable draft contracts for forum source references, provenance-typed community leads, public lead versions, signal clusters, research questions and proposals, and governance events. Public visibility is independent from evidentiary strength. Deidentified secondhand reports may be public research leads without being represented as subject-verified narratives.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "record_id", "payload", "created_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_type": {
      "enum": [
        "FORUM_SOURCE_REFERENCE",
        "COMMUNITY_LEAD",
        "PUBLIC_LEAD_VERSION",
        "SIGNAL_CLUSTER",
        "RESEARCH_QUESTION",
        "RESEARCH_PROPOSAL",
        "MODERATION_EVENT",
        "SCIENTIFIC_ANNOTATION",
        "PRIVACY_REVIEW",
        "SAFETY_CANDIDATE",
        "CONSENT_EVENT",
        "WITHDRAWAL_EVENT"
      ]
    },
    "record_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "payload": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "record_payload_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "FORUM_SOURCE_REFERENCE"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/forumSourceReference"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "COMMUNITY_LEAD"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/communityLead"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "PUBLIC_LEAD_VERSION"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/publicLeadVersion"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "SIGNAL_CLUSTER"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/signalCluster"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "RESEARCH_QUESTION"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/researchQuestion"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "RESEARCH_PROPOSAL"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/researchProposal"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "MODERATION_EVENT"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/moderationEvent"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "SCIENTIFIC_ANNOTATION"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/scientificAnnotation"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "PRIVACY_REVIEW"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/privacyReview"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "SAFETY_CANDIDATE"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/safetyCandidate"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "CONSENT_EVENT"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/consentEvent"}}}
    },
    {
      "if": {"properties": {"record_type": {"const": "WITHDRAWAL_EVENT"}}, "required": ["record_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/withdrawalEvent"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 300},
    "mediumText": {"type": "string", "minLength": 1, "maxLength": 4000},
    "longText": {"type": "string", "minLength": 1, "maxLength": 20000},
    "sourceDistance": {
      "enum": [
        "FIRSTHAND_SUBJECT",
        "FIRSTHAND_OBSERVER",
        "ONE_HOP_SUBJECT_RELAY",
        "MULTI_HOP_HEARSAY",
        "PUBLIC_SOURCE_EXTRACTED",
        "MIXED",
        "UNKNOWN"
      ]
    },
    "reporterRole": {
      "enum": [
        "SELF",
        "FRIEND",
        "FAMILY",
        "CAREGIVER",
        "CLINICIAN",
        "RESEARCHER",
        "PUBLIC_SOURCE_AUTHOR",
        "OTHER",
        "UNKNOWN"
      ]
    },
    "informationOrigin": {
      "enum": [
        "SELF_EXPERIENCE",
        "DIRECT_OBSERVATION",
        "SUBJECT_RELAYED_TO_REPORTER",
        "THIRD_PARTY_RELAYED",
        "DOCUMENTED_RECORD",
        "PUBLIC_SOURCE_EXTRACTION",
        "MIXED",
        "UNKNOWN"
      ]
    },
    "verificationState": {
      "enum": [
        "UNVERIFIED",
        "REPORTER_ACCOUNT_VERIFIED",
        "REPORTER_IDENTITY_VERIFIED_PRIVATE",
        "SUBJECT_ACKNOWLEDGED",
        "SUBJECT_VERIFIED",
        "DOCUMENT_CORROBORATED",
        "CLINICIAN_CORROBORATED",
        "MULTIPLE_CORROBORATION_TYPES",
        "CONFLICTED",
        "UNVERIFIABLE"
      ]
    },
    "evidenceCapability": {
      "enum": [
        "LEAD_ONLY",
        "DESCRIPTIVE_REPORT_ONLY",
        "TEMPORAL_ASSOCIATION_ONLY",
        "COMBINATION_ASSOCIATION_ONLY",
        "DECHALLENGE_SIGNAL",
        "RECHALLENGE_SIGNAL",
        "PROSPECTIVE_N_OF_1_SIGNAL",
        "FORMAL_EVIDENCE_LINKED",
        "UNRESOLVED"
      ]
    },
    "formalEvidenceRelationship": {
      "enum": [
        "NOT_CHECKED",
        "SUPPORT_NOT_LOCATED",
        "ADJACENT_ONLY",
        "CORROBORATED_FOR_MATCHED_SCOPE",
        "CONTRADICTED_FOR_MATCHED_SCOPE",
        "OUTCOME_MISMATCH",
        "POPULATION_MISMATCH",
        "INTERVENTION_MISMATCH",
        "TIME_HORIZON_MISMATCH",
        "FORMAL_EVIDENCE_CONFLICTED",
        "UNRESOLVED"
      ]
    },
    "leadStatus": {
      "enum": [
        "LEAD_CANDIDATE",
        "STRUCTURED",
        "PRIVACY_HOLD",
        "SAFETY_REVIEW",
        "PUBLIC",
        "CHALLENGED",
        "CORRECTED",
        "DUPLICATE_LINKED",
        "WITHDRAWAL_REQUESTED",
        "PUBLIC_WITHDRAWN",
        "SUPERSEDED",
        "UNVERIFIABLE",
        "REMOVED_POLICY_VIOLATION"
      ]
    },
    "consentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "notice_version", "decided_at"],
      "properties": {
        "decision": {"enum": ["YES", "NO", "WITHDRAWN", "NOT_ASKED"]},
        "notice_version": {"$ref": "#/$defs/shortText"},
        "consent_text_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "decided_at": {"$ref": "#/$defs/timestamp"},
        "actor_type": {"enum": ["REPORTER", "SUBJECT", "GUARDIAN", "AUTHORIZED_REPRESENTATIVE", "SYSTEM"]},
        "channel": {"enum": ["FORUM", "SECURE_PORTAL", "APP", "RESEARCH_INTERFACE", "ADMIN_CORRECTION"]}
      }
    },
    "forumSourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forum_service",
        "topic_id",
        "post_id",
        "source_version",
        "source_visibility",
        "occurred_at",
        "content_sha256"
      ],
      "properties": {
        "forum_service": {"enum": ["DISCOURSE", "OTHER_APPROVED"]},
        "forum_instance_id": {"$ref": "#/$defs/shortText"},
        "topic_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "post_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_version": {"type": "integer", "minimum": 1},
        "source_visibility": {"enum": ["PRIVATE", "MEMBER_ONLY", "PUBLIC", "DELETED", "UNKNOWN"]},
        "source_url": {"type": ["string", "null"], "format": "uri", "maxLength": 2000},
        "author_pseudonymous_id": {"type": ["string", "null"], "maxLength": 128},
        "occurred_at": {"$ref": "#/$defs/timestamp"},
        "received_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "approved_excerpt": {"type": ["string", "null"], "maxLength": 2000},
        "excerpt_publication_consent_id": {"type": ["string", "null"], "maxLength": 128},
        "deleted_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    },
    "reporter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reporter_id",
        "reporter_role",
        "information_origin",
        "source_distance",
        "verification_state"
      ],
      "properties": {
        "reporter_id": {"type": "string", "pattern": "^ARREP-[A-Z0-9_-]{8,64}$"},
        "reporter_role": {"$ref": "#/$defs/reporterRole"},
        "relationship_description": {"type": ["string", "null"], "maxLength": 500},
        "information_origin": {"$ref": "#/$defs/informationOrigin"},
        "source_distance": {"$ref": "#/$defs/sourceDistance"},
        "verification_state": {"$ref": "#/$defs/verificationState"},
        "public_attribution": {"enum": ["ANONYMOUS", "PSEUDONYM", "PUBLIC_HANDLE", "REAL_NAME", "NOT_PUBLIC"]},
        "conflict_disclosures": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 1000},
          "maxItems": 20
        }
      }
    },
    "subjectBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_private_ref_present",
        "subject_identifiability_in_source",
        "subject_identifiability_in_public_version",
        "direct_subject_quote_present",
        "subject_documents_or_media_present",
        "minor_status",
        "subject_acknowledgement_state"
      ],
      "properties": {
        "subject_private_ref_present": {"type": "boolean"},
        "subject_identifiability_in_source": {"enum": ["NONE", "LOW", "MODERATE", "HIGH", "DIRECT", "UNKNOWN"]},
        "subject_identifiability_in_public_version": {"enum": ["NONE", "LOW", "MODERATE", "HIGH", "DIRECT", "UNKNOWN"]},
        "direct_subject_quote_present": {"type": "boolean"},
        "subject_documents_or_media_present": {"type": "boolean"},
        "minor_status": {"enum": ["ADULT", "MINOR", "UNKNOWN"]},
        "subject_acknowledgement_state": {"enum": ["NOT_REQUESTED", "INVITED", "ACKNOWLEDGED", "VERIFIED", "DISPUTED", "DECLINED", "UNREACHABLE"]},
        "subject_exact_version_approval": {"anyOf": [{"$ref": "#/$defs/consentDecision"}, {"type": "null"}]}
      }
    },
    "conditionEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_episode_id", "condition_name", "diagnostic_certainty"],
      "properties": {
        "condition_episode_id": {"type": "string", "pattern": "^ARC-[A-Z0-9_-]{4,64}$"},
        "condition_id": {"type": ["string", "null"], "maxLength": 200},
        "condition_name": {"$ref": "#/$defs/shortText"},
        "diagnostic_certainty": {
          "enum": [
            "CLINICIAN_CONFIRMED",
            "LAB_OR_CRITERIA_SUPPORTED",
            "SELF_IDENTIFIED",
            "REPORTED_BY_PROXY",
            "SUSPECTED",
            "UNKNOWN"
          ]
        },
        "diagnosis_source_summary": {"type": ["string", "null"], "maxLength": 2000},
        "population_stage": {"type": ["string", "null"], "maxLength": 1000},
        "baseline_summary": {"type": ["string", "null"], "maxLength": 4000}
      }
    },
    "interventionComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "name", "dose_known", "start_known"],
      "properties": {
        "component_id": {"type": "string", "pattern": "^ARIC-[A-Z0-9_-]{4,64}$"},
        "normalized_intervention_id": {"type": ["string", "null"], "maxLength": 200},
        "name": {"$ref": "#/$defs/shortText"},
        "formulation": {"type": ["string", "null"], "maxLength": 500},
        "route": {"type": ["string", "null"], "maxLength": 200},
        "dose_known": {"type": "boolean"},
        "dose_value": {"type": ["number", "null"]},
        "dose_unit": {"type": ["string", "null"], "maxLength": 100},
        "frequency": {"type": ["string", "null"], "maxLength": 500},
        "start_known": {"type": "boolean"},
        "start_description": {"type": ["string", "null"], "maxLength": 500},
        "end_description": {"type": ["string", "null"], "maxLength": 500},
        "adherence_summary": {"type": ["string", "null"], "maxLength": 2000},
        "dechallenge_summary": {"type": ["string", "null"], "maxLength": 3000},
        "rechallenge_summary": {"type": ["string", "null"], "maxLength": 3000}
      },
      "allOf": [
        {
          "if": {"properties": {"dose_known": {"const": true}}, "required": ["dose_known"]},
          "then": {"required": ["dose_value", "dose_unit"]}
        }
      ]
    },
    "interventionEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_episode_id", "episode_type", "components", "sequence_known"],
      "properties": {
        "intervention_episode_id": {"type": "string", "pattern": "^ARI-[A-Z0-9_-]{4,64}$"},
        "episode_type": {"enum": ["SINGLE", "COMBINATION", "SEQUENCE", "BACKGROUND", "UNKNOWN"]},
        "components": {
          "type": "array",
          "items": {"$ref": "#/$defs/interventionComponent"},
          "minItems": 1,
          "maxItems": 50
        },
        "sequence_known": {"type": "boolean"},
        "sequence_summary": {"type": ["string", "null"], "maxLength": 3000},
        "cointerventions_summary": {"type": ["string", "null"], "maxLength": 4000},
        "program_fingerprint": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "name", "reported_direction", "measurement_type"],
      "properties": {
        "outcome_id": {"type": "string", "pattern": "^ARO-[A-Z0-9_-]{4,64}$"},
        "name": {"$ref": "#/$defs/shortText"},
        "reported_direction": {"enum": ["IMPROVED", "WORSENED", "NO_CLEAR_CHANGE", "MIXED", "UNKNOWN"]},
        "reported_magnitude": {"enum": ["MINIMAL", "SMALL", "MODERATE", "LARGE", "VERY_LARGE", "UNKNOWN"]},
        "measurement_type": {
          "enum": [
            "SUBJECTIVE_GLOBAL",
            "VALIDATED_PATIENT_REPORTED",
            "DIRECT_OBSERVER",
            "DEVICE",
            "LAB",
            "CLINICIAN_ASSESSED",
            "HEALTHCARE_USE",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "baseline_value": {"type": ["number", "string", "null"]},
        "follow_up_value": {"type": ["number", "string", "null"]},
        "unit_or_scale": {"type": ["string", "null"], "maxLength": 200},
        "onset_after_intervention": {"type": ["string", "null"], "maxLength": 500},
        "duration_or_persistence": {"type": ["string", "null"], "maxLength": 1000},
        "current_status": {"enum": ["PERSISTED", "PARTIALLY_PERSISTED", "LOST_EFFECT", "REVERSED", "ONGOING_UNKNOWN", "UNKNOWN"]},
        "reporter_wording": {"type": ["string", "null"], "maxLength": 2000}
      }
    },
    "completenessProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_band", "field_status", "missing_material_fields"],
      "properties": {
        "overall_band": {"enum": ["MINIMAL", "PARTIAL", "MODERATE", "HIGH_DETAIL"]},
        "field_status": {
          "type": "object",
          "additionalProperties": {"enum": ["KNOWN", "PARTIAL", "UNKNOWN", "NOT_APPLICABLE"]},
          "maxProperties": 100
        },
        "missing_material_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 200},
          "uniqueItems": true,
          "maxItems": 100
        },
        "follow_up_questions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 1000},
          "maxItems": 50
        }
      }
    },
    "discoveryValueComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "novelty",
        "intervention_specificity",
        "reported_outcome_magnitude",
        "harm_urgency",
        "independent_replication",
        "formal_evidence_gap",
        "follow_up_tractability",
        "decision_importance"
      ],
      "properties": {
        "novelty": {"type": "integer", "minimum": 0, "maximum": 4},
        "intervention_specificity": {"type": "integer", "minimum": 0, "maximum": 4},
        "reported_outcome_magnitude": {"type": "integer", "minimum": 0, "maximum": 4},
        "harm_urgency": {"type": "integer", "minimum": 0, "maximum": 4},
        "independent_replication": {"type": "integer", "minimum": 0, "maximum": 4},
        "formal_evidence_gap": {"type": "integer", "minimum": 0, "maximum": 4},
        "follow_up_tractability": {"type": "integer", "minimum": 0, "maximum": 4},
        "decision_importance": {"type": "integer", "minimum": 0, "maximum": 4},
        "equity_or_neglect_importance": {"type": "integer", "minimum": 0, "maximum": 4},
        "rationales": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 2000},
          "maxProperties": 20
        },
        "composite_display_prohibited": {"const": true}
      }
    },
    "leadConsentLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_lead", "aggregate_research", "recontact", "direct_quote", "documents_or_media"],
      "properties": {
        "public_lead": {"$ref": "#/$defs/consentDecision"},
        "aggregate_research": {"$ref": "#/$defs/consentDecision"},
        "recontact": {"$ref": "#/$defs/consentDecision"},
        "direct_quote": {"$ref": "#/$defs/consentDecision"},
        "documents_or_media": {"$ref": "#/$defs/consentDecision"},
        "exact_regimen_publication": {"anyOf": [{"$ref": "#/$defs/consentDecision"}, {"type": "null"}]},
        "future_research": {"anyOf": [{"$ref": "#/$defs/consentDecision"}, {"type": "null"}]},
        "model_training": {"anyOf": [{"$ref": "#/$defs/consentDecision"}, {"type": "null"}]}
      }
    },
    "communityLead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lead_id",
        "lead_version",
        "source_references",
        "reporter",
        "subject_boundary",
        "conditions",
        "intervention_episodes",
        "outcomes",
        "verification_state",
        "evidence_capability",
        "formal_evidence_relationship",
        "completeness",
        "discovery_value_components",
        "consents",
        "status",
        "created_at"
      ],
      "properties": {
        "lead_id": {"type": "string", "pattern": "^ARLEAD-[A-Z0-9_-]{8,64}$"},
        "lead_version": {"type": "integer", "minimum": 1},
        "source_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/forumSourceReference"},
          "minItems": 1,
          "maxItems": 100
        },
        "reporter": {"$ref": "#/$defs/reporter"},
        "subject_boundary": {"$ref": "#/$defs/subjectBoundary"},
        "conditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/conditionEpisode"},
          "minItems": 1,
          "maxItems": 20
        },
        "intervention_episodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/interventionEpisode"},
          "minItems": 1,
          "maxItems": 50
        },
        "outcomes": {
          "type": "array",
          "items": {"$ref": "#/$defs/outcome"},
          "minItems": 1,
          "maxItems": 100
        },
        "adverse_event_summaries": {
          "type": "array",
          "items": {"$ref": "#/$defs/mediumText"},
          "maxItems": 100
        },
        "alternative_explanations": {
          "type": "array",
          "items": {"$ref": "#/$defs/mediumText"},
          "maxItems": 50
        },
        "verification_state": {"$ref": "#/$defs/verificationState"},
        "evidence_capability": {"$ref": "#/$defs/evidenceCapability"},
        "formal_evidence_relationship": {"$ref": "#/$defs/formalEvidenceRelationship"},
        "completeness": {"$ref": "#/$defs/completenessProfile"},
        "discovery_value_components": {"$ref": "#/$defs/discoveryValueComponents"},
        "consents": {"$ref": "#/$defs/leadConsentLedger"},
        "duplicate_or_linked_lead_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^ARLEAD-[A-Z0-9_-]{8,64}$"},
          "uniqueItems": true,
          "maxItems": 100
        },
        "status": {"$ref": "#/$defs/leadStatus"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "canonical_payload_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "deidentificationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "outcome", "risk_flags", "reviewed_at", "reviewer_role"],
      "properties": {
        "review_id": {"type": "string", "pattern": "^ARPRIV-[A-Z0-9_-]{8,64}$"},
        "outcome": {"enum": ["PASS", "FAIL", "HUMAN_REVIEW_REQUIRED", "PENDING"]},
        "risk_flags": {
          "type": "array",
          "items": {
            "enum": [
              "DIRECT_IDENTIFIER",
              "EXACT_DATE_OR_AGE",
              "RARE_CONDITION_INTERVENTION_COMBINATION",
              "PRECISE_LOCATION",
              "CLINICIAN_OR_CLINIC",
              "UNIQUE_SEARCHABLE_QUOTE",
              "IMAGE_OR_EXIF",
              "DOCUMENT_IDENTIFIER",
              "MINOR",
              "PUBLIC_BACKLINK_REIDENTIFICATION",
              "RELATIONAL_REIDENTIFICATION",
              "OTHER"
            ]
          },
          "uniqueItems": true,
          "maxItems": 30
        },
        "redactions_or_generalizations": {
          "type": "array",
          "items": {"$ref": "#/$defs/mediumText"},
          "maxItems": 50
        },
        "reviewed_at": {"$ref": "#/$defs/timestamp"},
        "reviewer_role": {"enum": ["PRIVACY_REVIEWER", "SYSTEM_PRECHECK", "LEGAL_REVIEWER"]},
        "rationale": {"type": ["string", "null"], "maxLength": 4000}
      }
    },
    "publicLeadVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_version_id",
        "lead_id",
        "lead_version",
        "publication_object_type",
        "public_title",
        "public_paraphrase",
        "source_distance_label",
        "reporter_publication_consent",
        "subject_exact_version_approval",
        "deidentification_review",
        "subject_identifiable_in_public_version",
        "direct_subject_quote_present",
        "documents_or_media_present",
        "limitations",
        "status",
        "public_payload_sha256"
      ],
      "properties": {
        "public_version_id": {"type": "string", "pattern": "^ARPUB-[A-Z0-9_-]{8,64}$"},
        "lead_id": {"type": "string", "pattern": "^ARLEAD-[A-Z0-9_-]{8,64}$"},
        "lead_version": {"type": "integer", "minimum": 1},
        "publication_object_type": {"enum": ["PUBLIC_RESEARCH_LEAD", "PUBLIC_NARRATIVE"]},
        "public_title": {"$ref": "#/$defs/shortText"},
        "public_paraphrase": {"$ref": "#/$defs/longText"},
        "source_distance_label": {"$ref": "#/$defs/shortText"},
        "reporter_publication_consent": {"$ref": "#/$defs/consentDecision"},
        "subject_exact_version_approval": {"anyOf": [{"$ref": "#/$defs/consentDecision"}, {"type": "null"}]},
        "deidentification_review": {"$ref": "#/$defs/deidentificationReview"},
        "subject_identifiable_in_public_version": {"type": "boolean"},
        "direct_subject_quote_present": {"type": "boolean"},
        "documents_or_media_present": {"type": "boolean"},
        "verification_state": {"$ref": "#/$defs/verificationState"},
        "evidence_capability": {"$ref": "#/$defs/evidenceCapability"},
        "formal_evidence_relationship": {"$ref": "#/$defs/formalEvidenceRelationship"},
        "limitations": {
          "type": "array",
          "items": {"$ref": "#/$defs/mediumText"},
          "minItems": 1,
          "maxItems": 50
        },
        "published_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "status": {"enum": ["DRAFT", "PRIVACY_REVIEW", "APPROVED", "PUBLISHED", "CHALLENGED", "WITHDRAWN", "SUPERSEDED"]},
        "public_payload_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"publication_object_type": {"const": "PUBLIC_NARRATIVE"}},
            "required": ["publication_object_type"]
          },
          "then": {
            "properties": {
              "subject_exact_version_approval": {
                "type": "object",
                "properties": {"decision": {"const": "YES"}},
                "required": ["decision"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"publication_object_type": {"const": "PUBLIC_RESEARCH_LEAD"}},
            "required": ["publication_object_type"]
          },
          "then": {
            "properties": {
              "reporter_publication_consent": {
                "type": "object",
                "properties": {"decision": {"const": "YES"}},
                "required": ["decision"]
              },
              "deidentification_review": {
                "type": "object",
                "properties": {"outcome": {"const": "PASS"}},
                "required": ["outcome"]
              },
              "subject_identifiable_in_public_version": {"const": false},
              "direct_subject_quote_present": {"const": false},
              "documents_or_media_present": {"const": false}
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population": {"type": ["string", "null"], "maxLength": 2000},
