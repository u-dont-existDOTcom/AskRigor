PORT=3000
PROTOCOL_DIR=./protocols
YOUTUBE_API_KEY=
# At least 32 random UTF-8 bytes; keep secret and never commit a real value.
ASKRIGOR_YOUTUBE_CONTINUATION_SECRET=
# Phase D2 internal receipt placeholders only; no public route uses them yet.
# At least 32 random UTF-8 bytes; keep secret and never commit a real value.
ASKRIGOR_EXTERNAL_EVIDENCE_RECEIPT_SECRET=
# Nonsecret signing-key identifier, for example external-evidence-v1.
ASKRIGOR_EXTERNAL_EVIDENCE_RECEIPT_KEY_ID=
NCBI_API_KEY=
NCBI_TOOL=askrigor
NCBI_EMAIL=
CROSSREF_MAILTO=
UPSTREAM_TIMEOUT_MS=20000
ASKRIGOR_PUBLIC_SERVER_ENABLED=false
ASKRIGOR_TRUSTED_CLIENT_IP_HEADER=
# Temporary metadata-only MCP connector diagnostics; leave false in routine use.
ASKRIGOR_MCP_HANDSHAKE_DIAGNOSTICS=false
