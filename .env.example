PORT=3000
PROTOCOL_DIR=./protocols
YOUTUBE_API_KEY=
# At least 32 random UTF-8 bytes; keep secret and never commit a real value.
ASKRIGOR_YOUTUBE_CONTINUATION_SECRET=
# Phase D2 internal receipt placeholders only; no public route uses them yet.
# At least 32 random UTF-8 bytes; keep secret and never commit a real value.
ASKRIGOR_EXTERNAL_EVIDENCE_RECEIPT_SECRET=
# Nonsecret signing-key identifier, for example external-evidence-v1.
ASKRIGOR_EXTERNAL_EVIDENCE_RECEIPT_KEY_ID=
# Controlled-research finalization and signed product acceptance. Install only
# during the reviewed controller activation. At least 32 random UTF-8 bytes.
ASKRIGOR_FINALIZATION_SIGNING_SECRET=
# Nonsecret finalization key identifier, for example finalization-v1.
ASKRIGOR_FINALIZATION_KEY_ID=
# Encrypted single-host controller checkpoint. All three values are optional in
# development but must be supplied together for resumable controlled Actions.
ASKRIGOR_RESEARCH_SESSION_DIRECTORY=
# Exactly 32 random bytes encoded as canonical unpadded base64url.
ASKRIGOR_RESEARCH_SESSION_ENCRYPTION_KEY_BASE64URL=
# Nonsecret checkpoint key identifier, for example session-key-v1.
ASKRIGOR_RESEARCH_SESSION_ENCRYPTION_KEY_ID=
NCBI_API_KEY=
NCBI_TOOL=askrigor
NCBI_EMAIL=
CROSSREF_MAILTO=
UPSTREAM_TIMEOUT_MS=20000
ASKRIGOR_PUBLIC_SERVER_ENABLED=false
ASKRIGOR_TRUSTED_CLIENT_IP_HEADER=
# Temporary metadata-only MCP connector diagnostics; leave false in routine use.
ASKRIGOR_MCP_HANDSHAKE_DIAGNOSTICS=false
# Optional exact study-audit read-through. The URL must use a SELECT-only
# PostgreSQL role. The feature remains off unless the literal switch is true.
ASKRIGOR_LIVING_EVIDENCE_REUSE_ENABLED=false
ASKRIGOR_LIVING_EVIDENCE_READER_DATABASE_URL=
ASKRIGOR_LIVING_EVIDENCE_SCHEMA=living_evidence
ASKRIGOR_LIVING_EVIDENCE_READER_SSLMODE=disable
# Public self-serve evidence-gap form. The database URL must use the dedicated
# role that can access only living_evidence.evidence_gap_submissions.
ASKRIGOR_EVIDENCE_GAP_INTAKE_ENABLED=false
ASKRIGOR_EVIDENCE_GAP_DATABASE_URL=
ASKRIGOR_EVIDENCE_GAP_DATABASE_SCHEMA=living_evidence
ASKRIGOR_EVIDENCE_GAP_DATABASE_SSLMODE=disable
# Exactly 32 random bytes encoded as canonical unpadded base64url.
ASKRIGOR_EVIDENCE_GAP_ENCRYPTION_KEY_BASE64URL=
ASKRIGOR_EVIDENCE_GAP_ENCRYPTION_KEY_ID=
# At least 32 random UTF-8 bytes for the separate internal review route.
ASKRIGOR_EVIDENCE_GAP_REVIEW_API_KEY=
# OAuth resource-server protection for connected research and private review.
# The public evidence-gap contribution form remains pseudonymous and account-free.
ASKRIGOR_OAUTH_ENABLED=false
ASKRIGOR_OAUTH_RESOURCE_URL=https://mcp.askrigor.com/mcp
ASKRIGOR_OAUTH_ISSUER_URL=
ASKRIGOR_OAUTH_JWKS_URL=
# Exact non-secret OAuth client ID and stable owner token subject. Production
# rejects otherwise-valid tokens from any other client or user.
ASKRIGOR_OAUTH_ALLOWED_CLIENT_ID=
ASKRIGOR_OAUTH_ALLOWED_SUBJECT=
# Reciprocal connected-research access. The URL must use the dedicated access
# role; the identity secret is exactly 32 random bytes in canonical base64url.
ASKRIGOR_RESEARCH_ACCESS_ENABLED=false
ASKRIGOR_RESEARCH_ACCESS_DATABASE_URL=
ASKRIGOR_RESEARCH_ACCESS_DATABASE_SCHEMA=living_evidence
ASKRIGOR_RESEARCH_ACCESS_DATABASE_SSLMODE=disable
ASKRIGOR_RESEARCH_IDENTITY_SECRET_BASE64URL=
# Owner-only proposal review. This URL must use the distinct function-only
# review role and must never be the migrator/canonical-writer URL.
ASKRIGOR_RESEARCH_REVIEW_ENABLED=false
ASKRIGOR_RESEARCH_REVIEW_DATABASE_URL=
ASKRIGOR_RESEARCH_REVIEW_DATABASE_SCHEMA=living_evidence
ASKRIGOR_RESEARCH_REVIEW_DATABASE_SSLMODE=disable
