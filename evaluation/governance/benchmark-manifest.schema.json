{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://askrigor.com/schemas/benchmark-manifest-v1.json",
  "title": "AskRigor Benchmark Manifest",
  "description": "Minimal immutable identity for an AskRigor evaluation epoch. This adapts manifest-bound evaluation practice; it is not a scientific scoring standard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "epochId",
    "createdAt",
    "benchmark",
    "evaluator",
    "modelUnderTest",
    "conditions",
    "run",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "epochId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sourceIdentity", "datasetIdentity"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceIdentity": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "datasetIdentity": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "license": {
          "type": ["string", "null"]
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sourceIdentity", "scoringMode"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceIdentity": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "scoringMode": {
          "enum": ["DETERMINISTIC", "LLM_JUDGE", "HYBRID", "HUMAN_PANEL"]
        },
        "judgeModels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "judgeConfigurationHash": {
          "type": ["string", "null"]
        }
      }
    },
    "modelUnderTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "endpointClass"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": ["string", "null"]
        },
        "endpointClass": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "instructionIdentity"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "labelBlindingCode": {
            "type": ["string", "null"]
          },
          "instructionIdentity": {
            "$ref": "#/$defs/artifactIdentity"
          },
          "universalProtocolVersion": {
            "type": ["string", "null"]
          },
          "universalProtocolSha256": {
            "type": ["string", "null"]
          },
          "hrpVersion": {
            "type": ["string", "null"]
          },
          "hrpSha256": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "parameters",
        "runtimeIdentity",
        "sealedBeforeProtocolRepair"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "parameters": {
          "type": "object"
        },
        "runtimeIdentity": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "sealedBeforeProtocolRepair": {
          "type": "boolean"
        },
        "cost": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "currency": {
          "type": ["string", "null"]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "identity"],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "$ref": "#/$defs/artifactIdentity"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": [
            "GIT_COMMIT",
            "GIT_TREE",
            "GIT_BLOB",
            "SHA256",
            "MD5",
            "ARXIV_VERSION",
            "DOI_VERSION",
            "IMMUTABLE_URI",
            "COMPOSITE"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
