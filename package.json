{
  "name": "askrigor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/contracts packages/protocol packages/sources packages/evidence-repository apps/research-mcp",
    "typecheck": "tsc -b --pretty false packages/contracts packages/protocol packages/sources packages/evidence-repository apps/research-mcp",
    "test": "vitest",
    "test:run": "vitest run",
    "test:site": "tsx scripts/validate-public-site.mts",
    "test:site-deploy": "vitest run tests/public-site-deployment.test.ts",
    "test:live": "NO_COLOR=1 ASKRIGOR_LIVE_TESTS=1 vitest run tests/live-smoke.test.ts",
    "verify": "npm run typecheck && npm run test:run && npm run build",
    "validate:gemini-handoff": "tsx scripts/validate-gemini-youtube-candidate-handoff.mts",
    "validate:custom-gpt-product": "tsx scripts/custom-gpt-product-acceptance.mts",
    "generate:action-openapi": "tsx scripts/generate-action-openapi.mts",
    "generate:custom-gpt": "tsx scripts/generate-custom-gpt-packet.mts",
    "sync:retraction-watch": "tsx scripts/sync-retraction-watch.mts",
    "sync:retraction-watch:runtime": "node apps/research-mcp/dist/retraction-watch-sync-cli.js",
    "pilot:hermes": "tsx scripts/run-hermes-worker-pilot.mts",
    "test:hermes-pilot": "tsx scripts/smoke-hermes-semantic-worker.mts",
    "validate:n8n-pilot": "tsx scripts/validate-n8n-control-plane-workflow.mts",
    "test:n8n-pilot": "tsx scripts/smoke-n8n-control-plane.mts",
    "plugin:receipt": "node scripts/plugin-package-receipt.mjs",
    "lessons:status": "tsx scripts/lessons-status.mts",
    "living-evidence:preflight": "tsx scripts/living-evidence-task-preflight.mts",
    "living-evidence:acceptance": "npm run contributor-access:acceptance",
    "living-evidence:pilot": "tsx scripts/run-living-evidence-pilot.mts",
    "living-evidence:restore-verify": "tsx scripts/verify-living-evidence-restore.mts",
    "living-evidence:local": "bash scripts/run-living-evidence-local-pilot.sh",
    "contributor-access:preflight": "tsx scripts/contributor-access-task-preflight.mts",
    "contributor-access:deterministic-acceptance": "tsx scripts/accept-research-contributor-access.mts",
    "contributor-access:acceptance": "npm run contributor-access:deterministic-acceptance && npm run contributor-access:postgres-acceptance",
    "contributor-access:postgres-acceptance": "bash scripts/run-research-contributor-access-postgres-acceptance.sh",
    "owner-review:preflight": "tsx scripts/owner-review-task-preflight.mts",
    "owner-review:acceptance": "npm run contributor-access:acceptance",
    "promotion-scheduler:preflight": "tsx scripts/promotion-scheduler-task-preflight.mts",
    "promotion-scheduler:acceptance": "tsx scripts/accept-promotion-scheduler.mts",
    "external-evaluation:preflight": "tsx scripts/external-evaluation-task-preflight.mts",
    "external-evaluation:acceptance": "tsx scripts/accept-external-evaluation.mts",
    "external-evaluation:governance": "tsx scripts/validate-benchmark-governance.mts",
    "external-evaluation:difficulty-preflight": "tsx scripts/validate-terminal-bench-difficulty-preflight.mts",
    "external-evaluation:review-request": "tsx scripts/validate-observable-evidence-review-request.mts",
    "external-evaluation:noharm-pilot": "tsx scripts/validate-mast-noharm-pilot.mts",
    "validate:chat-work-authority": "tsx scripts/validate-chat-work-authority-policy.mts",
    "community-forum:lab-validate": "tsx scripts/validate-discourse-synthetic-lab.mts",
    "community-forum:acceptance": "tsx scripts/community-forum-synthetic-acceptance.mts",
    "community-forum:runtime-acceptance": "bash scripts/run-discourse-synthetic-acceptance.sh",
    "evidence-gap:synthetic-lab": "tsx scripts/run-synthetic-evidence-gap-lab.mts",
    "evidence-gap:synthetic-acceptance": "tsx scripts/accept-synthetic-evidence-gap-lab.mts",
    "evidence-gap:public-acceptance": "tsx scripts/accept-public-evidence-gap-intake.mts",
    "review:public-live": "tsx scripts/run-public-review-eval.mts",
    "dev:mcp": "tsx apps/research-mcp/src/index.ts",
    "start:mcp": "node apps/research-mcp/dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fast-xml-parser": "5.10.1",
    "jose": "6.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
