{
  "name": "askrigor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "tsc -b packages/contracts packages/protocol packages/sources apps/research-mcp",
    "typecheck": "tsc -b --pretty false packages/contracts packages/protocol packages/sources apps/research-mcp",
    "test": "vitest",
    "test:run": "vitest run",
    "test:site": "tsx scripts/validate-public-site.mts",
    "test:site-deploy": "vitest run tests/public-site-deployment.test.ts",
    "test:live": "NO_COLOR=1 ASKRIGOR_LIVE_TESTS=1 vitest run tests/live-smoke.test.ts",
    "verify": "npm run typecheck && npm run test:run && npm run build",
    "generate:action-openapi": "tsx scripts/generate-action-openapi.mts",
    "generate:custom-gpt": "tsx scripts/generate-custom-gpt-packet.mts",
    "lessons:status": "tsx scripts/lessons-status.mts",
    "review:public-live": "tsx scripts/run-public-review-eval.mts",
    "dev:mcp": "tsx apps/research-mcp/src/index.ts",
    "start:mcp": "node apps/research-mcp/dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fast-xml-parser": "5.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
