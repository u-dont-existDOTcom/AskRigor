import { readFile, readdir, writeFile } from "node:fs/promises";
import { fileURLToPath } from "node:url";
import { resolve } from "node:path";

const root = new URL("../", import.meta.url);
/** Extract only structural declarations: JSON Schema enums/consts, z.enum/z.literal, literal unions and named code arrays. */
export async function checkReportVocabulary(): Promise<{ tools: string[]; codes: string[] }> {
  const inventory = JSON.parse(await readFile(new URL("docs/tool-inventory-v0.1.0.json", root), "utf8"));
  const codes = new Set<string>();
  const code = (value: unknown) => { if (typeof value === "string" && /^[A-Za-z][A-Za-z0-9_]*$/u.test(value)) codes.add(value); };
  const walk = (node: unknown): void => {
    if (typeof node !== "object" || node === null) return;
    if (Array.isArray(node)) { for (const child of node) walk(child); return; }
    const object = node as Record<string, unknown>;
    if (Array.isArray(object.enum)) object.enum.forEach(code);
    if ("const" in object) code(object.const);
    Object.values(object).forEach(walk);
  };
  walk(inventory);
  const files = async (directory: URL): Promise<URL[]> => {
    const found: URL[] = [];
    for (const entry of await readdir(directory, { withFileTypes: true })) {
      const path = new URL(entry.name + (entry.isDirectory() ? "/" : ""), directory);
      if (entry.isDirectory()) found.push(...await files(path));
      else if (entry.name.endsWith(".ts") && entry.name !== "check-report-vocabulary.ts") found.push(path);
    }
    return found;
  };
  const sources = [...await files(new URL("apps/research-mcp/src/", root)),
    ...await files(new URL("packages/contracts/src/", root)), ...await files(new URL("packages/sources/src/", root))];
  for (const path of sources) {
    const text = await readFile(path, "utf8");
    const declarations = [
      ...text.matchAll(/\bz\.enum\(\s*\[([^\]]*)\]/gu),
      ...text.matchAll(/\b(?:code|reason_code|reasonCode|errorCode)\s*(?:=|:)\s*("[^"\n]*"|'[^'\n]*')/gu),
      ...text.matchAll(/\bz\.literal\(\s*("[^"\n]*"|'[^'\n]*')\s*\)/gu),
      ...text.matchAll(/\btype\s+\w+\s*=((?:\s*\|?\s*(?:"[^"\n]*"|'[^'\n]*'))+)\s*;/gu),
      ...text.matchAll(/\b(?:const|let)\s+\w*(?:CODES|STATUSES|KINDS|REASONS|STATES)\s*(?::[^=;]+)?=\s*(?:new Set(?:<[^>]+>)?\(\s*)?\[([^\]]*)\]/gu),
    ];
    // Resolve z.enum(NAME)'s static array in the same source. No evaluation of source code or caller data.
    for (const [, name] of text.matchAll(/\bz\.enum\(([A-Za-z_$][\w$]*)\)/gu)) {
      const declaration = new RegExp(`\\b(?:const|let)\\s+${name}\\s*=\\s*\\[([^\\]]*)\\]`, "u").exec(text);
      if (declaration !== null) declarations.push(declaration as RegExpMatchArray);
    }
    for (const declaration of declarations) {
      for (const match of declaration[1]!.matchAll(/"([A-Za-z][A-Za-z0-9_]*)"|'([A-Za-z][A-Za-z0-9_]*)'/gu)) code(match[1] ?? match[2]);
    }
  }
  return { tools: inventory.tools.map((tool: { name: string }) => tool.name).sort(), codes: [...codes].sort() };
}

export async function renderedCheckReportVocabulary(): Promise<string> {
  const vocabulary = await checkReportVocabulary();
  const versions: Record<string, string> = {};
  for (const [name, file] of [["hrp", "HRP_Full.xml"], ["universal", "Universal_Instructions.xml"]]) {
    const text = await readFile(new URL(`protocols/${file}`, root), "utf8");
    versions[name!] = /<Protocol\b[^>]*\bversion="([^"]+)"/u.exec(text)![1]!;
  }
  return '// Generated by scripts/generate-check-report-vocabulary.mts; exact server-owned names only.\n' +
    `export const REPORT_PROTOCOL_VERSIONS = ${JSON.stringify(versions)} as const;\n` +
    `export const REPORT_TOOL_NAMES: ReadonlySet<string> = new Set(${JSON.stringify(vocabulary.tools, null, 2)});\n` +
    `export const REPORT_CODE_NAMES: ReadonlySet<string> = new Set(${JSON.stringify(vocabulary.codes, null, 2)});\n`;
}
if (process.argv[1] !== undefined && fileURLToPath(import.meta.url) === resolve(process.argv[1])) {
  const text = await renderedCheckReportVocabulary();
  if (process.argv.includes("--write")) await writeFile(new URL("apps/research-mcp/src/check-report-vocabulary.ts", root), text);
  else process.stdout.write(text);
}
