askrigor.com {
	root * /srv/askrigor-site
	encode zstd gzip

	# Every response but the Atlas pages', which set their own headers below.
	@site not path /atlas /atlas/*
	header @site {
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; connect-src 'none'; upgrade-insecure-requests"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle / {
		rewrite * /index.html
		file_server
	}

	handle /privacy {
		rewrite * /privacy/index.html
		file_server
	}

	handle /terms {
		rewrite * /terms/index.html
		file_server
	}

	handle /support {
		rewrite * /support/index.html
		file_server
	}

	@assets path /assets/*
	handle @assets {
		file_server
	}

	# The public Atlas pages (decision 171, sections 4C to 4E), rendered by the research server. Their policy lets forms
	# post to this origin (form-action 'self') where the site's allows none, and still allows no script.
	@atlas path /atlas /atlas/*
	handle @atlas {
		header {
			Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()"
			Strict-Transport-Security "max-age=31536000"
			-Server
		}
		# Straight to the research server's container: the installer puts in ASKRIGOR_ATLAS_UPSTREAM (host:port) after
		# checking that the production Caddyfile already proxies to it, and the shared secret ASKRIGOR_ATLAS_PROXY_SECRET,
		# into the root-only combined Caddyfile. The Host stays askrigor.com, and the reader's address comes from this
		# connection, replacing any value a client sent; the research server believes it only with the secret and only on
		# requests for askrigor.com. Behind a CDN, use {client_ip} instead, with the CDN's ranges as trusted_proxies in the
		# global server options.
		reverse_proxy {$ASKRIGOR_ATLAS_UPSTREAM} {
			header_up X-AskRigor-Client-IP {remote_host}
			header_up X-AskRigor-Proxy-Secret {$ASKRIGOR_ATLAS_PROXY_SECRET}
		}
	}

	handle {
		respond 404
	}
}
